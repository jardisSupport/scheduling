{
    "name": "jardissupport/scheduling",
    "homepage": "https://jardis.io",
    "description": "Cron expression parsing and task scheduling with fluent API and timezone support",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Jardis Development",
            "email": "jardisDev@headgent.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "jardissupport/contracts": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5.63",
        "phpstan/phpstan": "2.1.56",
        "squizlabs/php_codesniffer": "3.13.6"
    },
    "autoload": {
        "psr-4": {
            "JardisSupport\\Scheduling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JardisSupport\\Scheduling\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/jardisSupport/scheduling/issues",
        "docs": "https://docs.jardis.io/en/support/scheduling",
        "email": "jardisDev@headgent.com"
    },
    "keywords": [
        "scheduling",
        "cron",
        "task",
        "task-scheduling",
        "cron-expression",
        "timer",
        "domain-driven-design",
        "php",
        "jardis",
        "headgent"
    ]
}
